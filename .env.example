# ── Server ──
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ── Database ──
# Absolute path to the SQLite file. Defaults to ./data/piece-tester.db
# DB_PATH=/opt/piece-tester/data/piece-tester.db

APP_AUTH_PASSWORD=change-me
SESSION_SECRET=

# ── Credential encryption ──
# Key used to encrypt the stored service-account password (AES-256-GCM).
# If unset, the app falls back to SESSION_SECRET; if neither is set, the app
# refuses to store the password (never plaintext). Set a long random value.
PIECE_TESTER_CRED_KEY=